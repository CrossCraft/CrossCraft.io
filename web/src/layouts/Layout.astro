---
interface Props {
  title: string;
  pageTitle: string;
  activeNav?: string;
  description?: string;
}

const {
  title,
  pageTitle,
  activeNav = '',
  description = 'CrossCraft is an open-source, clean-room reimplementation of Minecraft Classic 0.30 for PC, PSP, 3DS, Switch, and the browser.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/banner-hq.png', Astro.site);

const navLinks = [
  { label: 'Home', href: '/', id: 'home' },
  { label: 'Download', href: 'https://github.com/CrossCraft/CrossCraft/releases', id: 'download', external: true },
  { label: 'Server List', href: '/server-list', id: 'server-list' },
  { label: 'Github', href: 'https://github.com/CrossCraft/CrossCraft', id: 'github', external: true, icon: 'github' },
  { label: 'Discord', href: 'https://discord.gg/YvAK3B2BbE', id: 'discord', external: true, icon: 'discord' },
  { label: 'About', href: '/about', id: 'about' },
];
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#84ba56" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CrossCraft" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="CrossCraft banner" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />
  </head>
  <body>
    <header class="header">
      <a class="logo-link" href="/" aria-label="CrossCraft home">
        <img id="logo" src="/assets/logo.png" alt="CrossCraft logo" />
      </a>
      <nav class="nav">
        <div class="nav-tab">
          <div class="nav-links" id="nav-links">
            {
              navLinks.map((link) => (
                <a
                  class:list={['nav-btn', { active: link.id === activeNav }]}
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                  {link.icon && <i class={`bi bi-${link.icon}`} />}
                </a>
              ))
            }
          </div>
          <button class="nav-btn nav-toggle" id="nav-toggle" aria-label="Toggle navigation">☰</button>
        </div>
      </nav>
    </header>

    <div class="page_title">{pageTitle}</div>

    <main class:list={['content', { 'no-sidebar': !Astro.slots.has('sidebar') }]}>
      <div class="main">
        <slot />
      </div>
      {
        Astro.slots.has('sidebar') && (
          <aside class="side-right">
            <slot name="sidebar" />
          </aside>
        )
      }
    </main>

    <footer class="footer">
      <p>© 2026 The CrossCraft Team — Not affiliated with Mojang or Microsoft</p>
    </footer>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const links = document.getElementById('nav-links');
      toggle?.addEventListener('click', () => links?.classList.toggle('open'));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/main.css';
</style>
